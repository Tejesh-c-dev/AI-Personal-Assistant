{
  "name": "ai-personal-assistant",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.13.0",
    "npm": ">=11.8.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "smoke:openrouter": "node --conditions=react-server --import tsx scripts/smoke-openrouter.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:staging": "drizzle-kit migrate --config drizzle.staging.config.ts",
    "test:db": "node scripts/test-db.mjs",
    "test:local-chat": "node scripts/test-local-chat.mjs",
    "test:live-chat": "node --import ./scripts/test-network-guard.mjs scripts/test-live-chat.mjs"
  },
  "dependencies": {
    "@google/adk": "2.5.0",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.16",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3"
  }
}
